<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <Compile Update="Forms\MainForm.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="Forms\Dialogs\ImportConfigurationDialog.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="Forms\Dialogs\InputBoxDialog.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="Forms\Dialogs\ManageRelationsDialog.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="Forms\Dialogs\AddEditRelationsDialog.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="Forms\Dialogs\SelectRelationsDialog.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="Forms\ImportYamlConfigurationDIalog.cs">
        <SubType>Form</SubType>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CsvHelper" Version="33.1.0" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
      <PackageReference Include="YamlDotNet" Version="16.3.0" />
    </ItemGroup>

</Project>